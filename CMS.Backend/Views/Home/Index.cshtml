@model CMS.Backend.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid px-4">
    <h1 class="mt-4">Dashboard</h1>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item active">Dashboard Overview</li>
    </ol>

    <div class="row">
        <div class="col-xl-4 col-md-6">
            <div class="card bg-primary text-white mb-4 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="mb-0 fw-bold">@Model.TotalPosts</h3>
                    <div class="text-white-50">Total Posts</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between border-top-0" style="background-color: rgba(0,0,0,0.1);">
                    <a class="small text-white stretched-link text-decoration-none" asp-controller="Post" asp-action="Index">View Details</a>
                    <div class="small text-white">→</div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card bg-success text-white mb-4 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="mb-0 fw-bold">@Model.TotalProducts</h3>
                    <div class="text-white-50">Total Products</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between border-top-0" style="background-color: rgba(0,0,0,0.1);">
                    <a class="small text-white stretched-link text-decoration-none" asp-controller="Product" asp-action="Index">View Details</a>
                    <div class="small text-white">→</div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card bg-warning text-dark mb-4 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="mb-0 fw-bold">@Model.TotalOrders</h3>
                    <div class="text-dark-50">Total Orders</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between border-top-0" style="background-color: rgba(0,0,0,0.1);">
                    <a class="small text-dark stretched-link text-decoration-none" asp-controller="Order" asp-action="Index">View Details</a>
                    <div class="small text-dark">→</div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card bg-danger text-white mb-4 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="mb-0 fw-bold">@Model.TotalUsers</h3>
                    <div class="text-white-50">Total Users</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between border-top-0" style="background-color: rgba(0,0,0,0.1);">
                    <a class="small text-white stretched-link text-decoration-none" asp-controller="User" asp-action="Index">View Details</a>
                    <div class="small text-white">→</div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card bg-info text-white mb-4 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="mb-0 fw-bold">@Model.TotalCategories</h3>
                    <div class="text-white-50">Total Categories</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between border-top-0" style="background-color: rgba(0,0,0,0.1);">
                    <a class="small text-white stretched-link text-decoration-none" asp-controller="Category" asp-action="Index">View Details</a>
                    <div class="small text-white">→</div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6">
            <div class="card bg-secondary text-white mb-4 shadow-sm border-0">
                <div class="card-body">
                    <h3 class="mb-0 fw-bold">@Model.TotalCustomers</h3>
                    <div class="text-white-50">Total Customers</div>
                </div>
                <div class="card-footer d-flex align-items-center justify-content-between border-top-0" style="background-color: rgba(0,0,0,0.1);">
                    <a class="small text-white stretched-link text-decoration-none" asp-controller="Customer" asp-action="Index">View Details</a>
                    <div class="small text-white">→</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Latest Posts Table -->
        <div class="col-xl-7">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold">
                        📰 Latest Posts
                    </h5>
                    <a asp-controller="Post" asp-action="Index" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body">
                    @if (Model.LatestPosts == null || !Model.LatestPosts.Any())
                    {
                        <div class="alert alert-info text-center border-0 shadow-sm">Chưa có bài viết nào.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col" class="text-center" style="width: 80px;">Image</th>
                                        <th scope="col">Title</th>
                                        <th scope="col">Category</th>
                                        <th scope="col" class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LatestPosts)
                                    {
                                        <tr>
                                            <td class="text-center">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.Title" class="rounded" style="height: 40px; width: 60px; object-fit: cover;" />
                                                }
                                                else
                                                {
                                                    <div class="bg-secondary text-white rounded d-flex align-items-center justify-content-center" style="height: 40px; width: 60px;">
                                                        <span class="small" style="font-size: 0.6rem;">None</span>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <h6 class="mb-0 fw-bold text-dark text-truncate" style="max-width: 200px;">@item.Title</h6>
                                                <small class="text-muted">@item.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                            </td>
                                            <td>
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">
                                                    @(item.Category?.Name ?? "N/A")
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a asp-controller="Post" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                                    Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Latest Categories Table -->
        <div class="col-xl-5">
            <div class="card mb-4 shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-info fw-bold">
                        📂 Latest Categories
                    </h5>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-sm btn-outline-info">View All</a>
                </div>
                <div class="card-body">
                    @if (Model.LatestCategories == null || !Model.LatestCategories.Any())
                    {
                        <div class="alert alert-info text-center border-0 shadow-sm">Chưa có danh mục nào.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col">Description</th>
                                        <th scope="col" class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.LatestCategories)
                                    {
                                        <tr>
                                            <td>
                                                <h6 class="mb-0 fw-bold text-dark">@item.Name</h6>
                                            </td>
                                            <td>
                                                <span class="text-muted text-truncate d-inline-block" style="max-width: 150px;">
                                                    @(string.IsNullOrEmpty(item.Description) ? "Không có mô tả" : item.Description)
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <a asp-controller="Category" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info rounded-pill">
                                                    Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
